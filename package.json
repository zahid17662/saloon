{
  "name": "salon-software",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "Client",
    "Server"
  ],
  "scripts": {
    "dev": "next dev Client",
    "build": "node scripts/build.mjs",
    "start": "next start Client",
    "lint": "eslint",
    "test": "npm run test --workspace=Server",
    "typecheck": "tsc --noEmit -p Client/tsconfig.json && tsc --noEmit -p Server/tsconfig.json",
    "db:generate": "drizzle-kit generate --config Server/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config Server/drizzle.config.ts",
    "db:seed": "tsx Server/src/db/seed.ts",
    "db:studio": "drizzle-kit studio --config Server/drizzle.config.ts",
    "test:e2e": "playwright test",
    "e2e:init": "node scripts/e2e-init.mjs",
    "admin:reset-pin": "node scripts/reset-admin-pin.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6"
  }
}
