# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct (non-pooler) connection (used by drizzle-kit migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret for signing session cookies (HMAC). Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
