# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct (non-pooler) connection (used by drizzle-kit migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret for signing session cookies (HMAC). Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Login rate limiting keys on the client IP. On Vercel the proxy headers are trusted automatically.
# Behind your own reverse proxy that sets x-real-ip, set this to 1; otherwise logins are refused in production.
# TRUST_PROXY_HEADERS=1

# Optional, used only by `npm run db:seed` (initial admin PIN and shop code; change after first login).
# If unset, the seed falls back to the demo values (dev only). SEED_ENV=production requires both.
# SEED_ADMIN_PIN=""
# SEED_SHOP_CODE=""
# SEED_ENV=production
